# Copie para .env.local e preencha localmente.
# Nunca versionar segredos.

# Auth e Business Data são o MESMO projeto Supabase.
AUTH_SUPABASE_URL=
AUTH_SUPABASE_ANON_KEY=

# BASE QV — somente leitura. Obrigatória para Dados Gerais.
# Nunca expor DATA_SUPABASE_SERVICE_ROLE_KEY no navegador.
DATA_SUPABASE_URL=
DATA_SUPABASE_SERVICE_ROLE_KEY=

# Opcionais — demais dashboards.
# PHARUS_SUPABASE_URL=
# PHARUS_SUPABASE_ANON_KEY=
# PHARUS_SUPABASE_SERVICE_ROLE_KEY=
# PHARUS_SUPABASE_SCHEMA=core
# QV360_SUPABASE_URL=
# QV360_SUPABASE_ANON_KEY=
# QV360_SUPABASE_SERVICE_ROLE_KEY=
# Alias opcional do mesmo projeto Auth (schema analytics / research).
# BUSINESS_DATA_SUPABASE_URL=
# Schema de acionamentos/Calendly. Default: research
# BUSINESS_DATA_SUPABASE_SCHEMA=research
# Catálogo e snapshot analíticos: AUTH_SUPABASE_ANON_KEY + JWT da sessão.
# Não criar BUSINESS_DATA_SUPABASE_ANON_KEY nem service role para isso.
# Não apontar BUSINESS_DATA_SUPABASE_URL para a BASE QV.
# Persistência local do snapshot (npm run analytics:snapshot:build -- --persist):
# ANALYTICS_ACCESS_TOKEN=
# POC Etapa 5 — snapshot derivado Análises Estatísticas (Business Data schema analytics)
# Leitura/escrita: AUTH_SUPABASE_ANON_KEY + JWT da sessão (role authenticated + RLS).
# Refresh autenticado: POST /api/analytics?action=refresh-statistical-snapshot
# CLI local (opcional): ANALYTICS_ACCESS_TOKEN=<JWT da sessão>
# Leitura snapshot na API (default false até fidelity aprovada):
# STATISTICAL_SNAPSHOT_ENABLED=false
# Schema do backup Airtable (primeira reunião). Default: bkp_airtable
# AIRTABLE_BKP_SCHEMA=bkp_airtable
# Schema dos eventos Calendly (gráfico Reuniões por tipo). Default: Agendamentos
# CALENDLY_EVENTOS_SCHEMA=Agendamentos
# Ponte opcional se o schema Calendly não estiver exposto no REST.
# N8N_MEETING_TYPES_WEBHOOK_URL=
# N8N_INTERNAL_API_TOKEN=
# Assistente V2 (server-side only — nunca expor no frontend)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TIMEOUT_MS=25000
